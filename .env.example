# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# Public address of this app (no trailing slash). Used in emails and sign in links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The email address of the platform owner (you). This person gets the owner dashboard.
PLATFORM_OWNER_EMAIL=

# Supabase (Project Settings, API). The publishable key is safe in the browser; the secret key is NOT.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Email. Pick ONE way to send. With neither set, emails are printed to the server log.
# Every attempt is listed in the Email log on the owner dashboard.
# EMAIL_PROVIDER can force smtp, resend or log; leave it empty to choose automatically.
EMAIL_PROVIDER=

# Option A, no domain needed: a Gmail account with an app password (500 recipients a day).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Option B, once you own a domain: Resend with a verified domain.
RESEND_API_KEY=

# Sender name and address. With Gmail it must be the Gmail address, for example CiteDesk <you@gmail.com>.
EMAIL_FROM=

# Time zone for dates on the dashboards (servers run in UTC). Any IANA name.
DISPLAY_TIMEZONE=America/Chicago

# Cloudflare Turnstile (bot check on the request form). Without it, the check is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Live demo only (the Ledgerly sample bot at /demo). Optional; without it the demo runs in demo mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
DAILY_LIMIT_PER_IP=20
